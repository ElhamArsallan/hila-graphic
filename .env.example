# Development-only defaults. Copy to .env.local for local development.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
STORAGE_PROVIDER=local
DATA_DIR=data
DATA_FILE_PATH=data/site-data.json
UPLOAD_DIR=public/uploads
ADMIN_CREDENTIAL_PATH=.admin-credentials.json
DISABLE_HMR=false

# Required in production. The host should inject PORT and provide HTTPS.
# Production startup refuses to use local JSON or local permanent media storage.
# NODE_ENV=production
# HOST=0.0.0.0
# DATABASE_URL=
# STORAGE_PROVIDER=r2
# SESSION_SECRET=
# ADMIN_PASSWORD=  # Required only until an admin credential exists in PostgreSQL.
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_ACCESS_KEY_ID=
# OBJECT_STORAGE_SECRET_ACCESS_KEY=
# OBJECT_STORAGE_PUBLIC_URL=https://media.example.com

# Optional production settings.
# TRUST_PROXY_HOPS=1  # Set to the exact number of trusted reverse-proxy hops.
# OBJECT_STORAGE_ENDPOINT=  # Optional for AWS; for R2, set this or R2_ACCOUNT_ID.
# OBJECT_STORAGE_REGION=auto  # R2 uses auto; AWS S3 normally uses its region name.
# UPLOAD_STAGING_DIR=  # Temporary writable directory; defaults to the OS temp directory.
# FONTS_DIR=public/fonts
# PRIVATE_DOWNLOAD_DIR=.admin-downloads  # Temporary generated admin archives only.

# Optional R2 aliases; use these instead of the corresponding OBJECT_STORAGE_* values.
# R2_ACCOUNT_ID is required when OBJECT_STORAGE_ENDPOINT is omitted for R2.
# R2_ACCOUNT_ID=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=https://media.example.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Optional AWS S3 aliases. OBJECT_STORAGE_ENDPOINT may be omitted to use AWS defaults.
# S3_BUCKET_NAME=
# S3_PUBLIC_URL=https://media.example.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Development/local-storage overrides only. Do not use these as production persistence.
# DATA_DIR=data
# DATA_FILE_PATH=data/site-data.json
# UPLOAD_DIR=public/uploads
# ADMIN_CREDENTIAL_PATH=.admin-credentials.json